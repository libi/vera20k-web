+    record_io_error(
+        &mut report,
+        UdpChannel::Primary,
+        UdpIoOperation::Send,
+        io::ErrorKind::WouldBlock.into(),
+    );
+    assert_eq!(report.send_would_block, 1);
+    assert!(report.first_io_error.is_none());
+    assert!(!report.delivery_failed());
+
+    record_io_error(
+        &mut report,
+        UdpChannel::Primary,
+        UdpIoOperation::Send,
+        io::ErrorKind::ConnectionAborted.into(),
+    );
+    let failure = report.first_io_error.as_ref().unwrap();
+    assert_eq!(failure.channel, UdpChannel::Primary);
+    assert_eq!(failure.operation, UdpIoOperation::Send);
+    assert_eq!(failure.error.kind(), io::ErrorKind::ConnectionAborted);
